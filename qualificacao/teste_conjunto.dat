reset;
set S ordered := {5, 10, 15, 20, 25};  

# Create an indexed parameter to store elements
param S_list {1..card(S)};  

# Manually map the elements using a known order
let S_list[1] := 5;
let S_list[2] := 10;
let S_list[3] := 15;
let S_list[4] := 20;
let S_list[5] := 25;

# Generate a random index
param rand_idx := round(Uniform(1, card(S)));  

# Get the random element
param rand_elem := S_list[rand_idx];

display rand_elem;
printf "\n\ncard(S) = %d\n\n",card(S);


