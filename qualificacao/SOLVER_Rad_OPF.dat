# Critérios de Qualidade de Energia

let FPminInd := 0.92;
let FPminCap := 0.92;
let Vmax := 1.05*Vnom/Vbase;     #Per unit
let Vmin := 0.95*Vnom/Vbase;     #Per unit

# =========  ||  =========  ||  =========  ||  =========  ||  =========

# Ajustes das Variáveis de Decisão

let NMC:= 3;			# Número máximo de CB em cada barra
let qcb:= -300/Sbase;

fix{i in N,t in PER} Qscb[i,t] := 0;
fix{i in N} Qfcb[i] := 0;

fix{i in N,t in PER} PsaeC[i,t] := 0;
fix{i in N,t in PER} PsaeD[i,t] := 0;

fix{i in N,(t,s) in SC} Ppv[i,t,s] := 0;
fix{i in N,(t,s) in SC} Qpv_1[i,t,s] := 0;
fix{i in N,(t,s) in SC} Qpv_2[i,t,s] := 0;
fix{i in N,(t,s) in SC} Qpv_4[i,t,s] := 0;
fix{i in N,(t,s) in SC} Qpv_5[i,t,s] := 0;

fix{i in N, t in PER} Pgd[i,t] := 0;
fix{i in N,t in PER} Qgd[i,t] := 0;

for{i in N}{

	if i in CB then {
		unfix Qfcb[i];
		for {t in PER}{
			unfix Qscb[i,t];
		}
	}
	if i in BB then {
		for {t in PER}{
			unfix PsaeC[i,t];
			unfix PsaeD[i,t];
		}
	}
	if i in PV then {
		for {(t,s) in SC}{
			unfix Ppv[i,t,s];
			unfix Qpv_1[i,t,s];
			unfix Qpv_2[i,t,s];
			unfix Qpv_4[i,t,s];
			unfix Qpv_5[i,t,s];
		}	
	}
	if i in GD then {
		for {t in PER}{
			unfix Pgd[i,t];
			unfix Qgd[i,t];
		}
	}
}

# Inicializando Variáveis

