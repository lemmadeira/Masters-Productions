#VND - neighborhood 2

restore neighborhood_VND2_FCB01;
restore neighborhood_VND2_FCB02;
restore neighborhood_VND2_SCB01;
restore neighborhood_VND2_SCB02;
restore neighborhood_VND2_BB01;
restore neighborhood_VND2_BB02;
restore neighborhood_VND2_PV01;
restore neighborhood_VND2_PV02;
restore neighborhood_VND2_GD01;
restore neighborhood_VND2_GD02;
	
#Soluciona o modelo
printf "\n\n\t\t ENTROU s = %d\n\n",s;
solve FO;

#Remove the constraints

drop neighborhood_VND2_FCB01;
drop neighborhood_VND2_FCB02;
drop neighborhood_VND2_SCB01;
drop neighborhood_VND2_SCB02;
drop neighborhood_VND2_BB01;
drop neighborhood_VND2_BB02;
drop neighborhood_VND2_PV01;
drop neighborhood_VND2_PV02;
drop neighborhood_VND2_GD01;
drop neighborhood_VND2_GD02;

if FO < incumbente then {
				
	let incumbente := FO;
	printf "\n\n\n\n\n\t\t\t\t\t\t\t\t MELHOROU s = %d\t\t\tFO = %.2f\n\n\n\n\n",s,incumbente;
	
	# Integraliza variaveis
	let {i in CB} Nfcb[i] := round(Nfcb[i]);
	let {i in CB} Nscb_max[i] := round(Nscb_max[i]);
	let {i in BB} Nsae[i] := round(Nsae[i]);
	let {i in PVds} Npv[i] := round(Npv[i]);
	let {i in GD} Ngd[i] := round(Ngd[i]);
	
	# Atualiza os valores atuais das variáveis de decisão
	let {i in CB} Nfcb_ngbh[i] := Nfcb[i];
	let {i in CB} Nscb_max_ngbh[i] := Nscb_max[i];
	let {i in BB} Nsae_ngbh[i] := Nsae[i];
	let {i in PVds} Npv_ngbh[i] := Npv[i];
	let {i in GD} Ngd_ngbh[i] := Ngd[i];
	
	# Atualiza vizinhança
	let s := 1;
	let k := 1;
	
}

else {
	
	printf "\n\n\t\t NAO MELHOROU s = %d\n\n",s;
	let s := s + 1;
	
}