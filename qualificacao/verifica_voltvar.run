for {y in Y}{
	for {i in PVin}{
		for {(t,ss) in SC}{
			if (sqrt(V2[y,i,t,ss]))<=V1pv then {
				let k_pv_in[y,i,t,ss] := abs(Qpv_in[y,i,t,ss] - Qpv_max)/(FRV*iter)/Qpv_max;
				let Npv_in_ngbh[y,i,t,ss] := Qpv_max/Qpv_max;
			}
			else {
				if (sqrt(V2[y,i,t,ss]))<=V2pv then { 
					let k_pv_in[y,i,t,ss] := abs(Qpv_in[y,i,t,ss] - (Qpv_max + omega1*(sqrt(V2[y,i,t,ss]) - V1pv)) )/(FRV*iter)/Qpv_max;
					let Npv_in_ngbh[y,i,t,ss] := (Qpv_max + omega1*(sqrt(V2[y,i,t,ss]) - V1pv))/Qpv_max;
				}
				else {
					if (sqrt(V2[y,i,t,ss]))<=V3pv then {
						let k_pv_in[y,i,t,ss] := abs(Qpv_in[y,i,t,ss] - 0)/(FRV*iter)/Qpv_max;
						let Npv_in_ngbh[y,i,t,ss] := 0;
					}
					else {
						if (sqrt(V2[y,i,t,ss]))<=V4pv then {
							let k_pv_in[y,i,t,ss] := abs(Qpv_in[y,i,t,ss] - (Qpv_min + omega2*(sqrt(V2[y,i,t,ss]) - V4pv)) )/(FRV*iter)/Qpv_max;
							let Npv_in_ngbh[y,i,t,ss] := (Qpv_min + omega2*(sqrt(V2[y,i,t,ss]) - V4pv))/Qpv_max;
						}
						else {
							let k_pv_in[y,i,t,ss] := abs(Qpv_in[y,i,t,ss] - Qpv_min)/(FRV*iter)/Qpv_max;
							let Npv_in_ngbh[y,i,t,ss] := Qpv_min/Qpv_max;
						}
					}
				}
			} 
		}
	}
}