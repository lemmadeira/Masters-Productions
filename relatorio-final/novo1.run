# -------------------- LOADING THE MODEL --------------------- #

reset;
param w;
let w := 0;

include OPFvar33.dat;
data bus33.dat;
include OPF.dat;

include GVNSvar.dat;
include VND_ngbh1.mod;
include VND_ngbh2.mod;
include VND_ngbh3.mod;

model OPFhc.mod;
#drop PV03_operacao;
#drop PV04_operacao;
#drop PV05_operacao;
#drop PV06_operacao;
#drop PV07_operacao;

# ------------------------------------------------------------ #

# ---------------------- CHOSING THE SOLVER ------------------ #

option solver gurobi;
#option presolve 0;
#option knitro_options "opttol = 0.01 maxtime = 180 bar_conic_enable=1";

# ------------------------------------------------------------ #

option log_file 'resultsBB.log';
repeat while (w<=1) {

	printf"\n\n||  =========  ||  =========  ||  =========  ||  =========  ||  =========  ||  =========    \n\n";
	printf"\n\n||  =========  ||  =========  ||  =========  ||  =========  ||  =========  ||  =========    \n\n";
	printf"\t\t\t\t\t\t\t\t lambda = %d",w;
	printf"\n\n||  =========  ||  =========  ||  =========  ||  =========  ||  =========  ||  =========    \n\n";
	printf"\n\n||  =========  ||  =========  ||  =========  ||  =========  ||  =========  ||  =========    \n\n";

	# ---------------- INICIALIZING GVNS VARIABLES --------------- #

	option gurobi_options 'mipgap = 0.01 timelim = 150';
	let startTime := time();
	include inicializacao_var_restricoes.run;

	let incumbente := (-1)*1e30;		# Defininig an incumbent
	#include verifica_voltvar.run;

	printf"\n\n||  =========  ||  =========  ||  =========  ||  =========  ||  =========  ||  =========    \n\n";

	# ------------------------------------------------------------ #

	# ----------------------   THE BEGINNING OF ITERATION PROCESS:    GVNS     ------------------------- #

	repeat while (iter <= iter_max and ((time() - startTime) <= time_max) ) {

		printf "\n\n\t\t\t ITERACAO %d\t%d\n\n",iter,k;
		
		if k == 1 then {
		
			include implementa_GVNS_NGBH1.run;
			
		}
		
		else {
		
			include implementa_GVNS_NGBH2.run;
			
		}
		
		if s == 1 then {
			
			include implementa_VND_NGBH1.run;
			
		}
		
		if s == 2 then {
		
			include implementa_VND_NGBH2.run;
		
		}
		
		if s == 3 then {
		
			include implementa_VND_NGBH3.run;
		
		}
		
		let {i in CB} Nfcb_ngbh[i] := Nfcb_best[i];
		let {i in CB} Nscb_max_ngbh[i] := Nscb_max_best[i];
		let {i in CB, t in PER} Nscb_ngbh[i,t] := Nscb_best[i,t];
		let {i in BB} Nsae_ngbh[i] := Nsae_best[i];
		#let {i in PV} Npv[i] := Npv_best[i];
		let {i in GD} Ngd[i] := Ngd_best[i];
		#include verifica_voltvar.run;
			
		if k > k_max then {
		
			let k := 1;
			#include implementa_GVNS_NGBH2.run;
			let iter := iter + 1;
			
		}
		
		printf "\n\n----------------------------------------------------------------------------\n\n";
		display time() - startTime;
		printf "----------------------------------------------------------------------------\n\n";
		
		
		if iter > iter_max || (time() - startTime >= time_max) then {
			
			#let M := 0;
			#drop operacao01;
			#drop operacao02;
			#drop operacao03;
			#drop operacao04;
			#drop operacao05;
			let {i in CB, t in PER} Nscb[i,t] := Nscb_best[i,t];
			let {i in CB} Nfcb[i] := Nfcb_best[i];
			let {i in CB} Nscb_max[i] := Nscb_max_best[i];
			let {i in BB} Nsae[i] := Nsae_best[i];
			#let {i in PV} Npv[i] := Npv_best[i];
			let {i in GD} Ngd[i] := Ngd_best[i];
			#let {y in Y,i in PV, (t,ss) in SC} Npv_in[y,i,t,ss] := Npv_in_ngbh[y,i,t,ss];
			let {i in PV} Pper[i] := Pper_best[i];
			fix {i in CB} Nfcb[i];
			fix {i in CB} Nscb_max[i];
			fix {i in CB, t in PER} Nscb[i,t];
			fix {i in BB} Nsae[i];	
			fix {i in PV} Pper[i];
			#fix {i in PV} Npv[i];
			fix {i in GD} Ngd[i];
			#fix {y in Y,i in PV, (t,ss) in SC} Npv_in[y,i,t,ss];

			option gurobi_options 'mipgap = 0.01 timelim = 150';
			#option knitro_options "opttol = 0.001 maxtime = 180 bar_conic_enable=1";
			solve FO;
			
			if sum{y in Y}( (Sbase/Vbase)*(sum {(i,j) in B}sum{(t,s) in SC}(I2pen[y,i,j,t,s]))   +   (Sbase)*(sum{i in N}( sum {(t,s) in SC}(QSpen_folga[y,i,t,s] + QSpen_excesso[y,i,t,s] + V2pen_folga[y,i,t,s] + V2pen_excesso[y,i,t,s] + S2pen[y,i,t,s])))  ) > 0.0001 then {
			
				printf "\n\n \t\t Solucao Infactivel\n\n";
				#let iter := iter - 10;
				
			}
			
			else {
			
				printf "\n\n\t\t Solucao Factivel\n\n";
			
			}
			
		}
		
	}

	# ------------------------------------------------------------ #

	include disp_variables.run;

	## ------------------------------------------------------------ #
	#
	#printf '\n\n\n\n\n\n\nSolucao via SOLVER\n\n\n\n';
	#
	#drop PV01_operacao;
	#drop PV02_operacao;
	#restore PV03_operacao;
	#restore PV04_operacao;
	#restore PV05_operacao;
	#restore PV06_operacao;
	#restore PV07_operacao;
	##let{y in Y,i in N,(t,s) in SC} V2[y,i,t,s] := 0;
	#let{y in Y,i in N,(t,s) in SC} Qpv_in[y,i,t,s] := 0;
	#option gurobi_options 'mipgap = 0.01 timelim = 1800';
	#solve FO;
	#
	## ------------------------------------------------------------ #
	#
	#include disp_variables.run;
	#
	## ------------------------------------------------------------ # 

	let w := w + 0.7;
	purge;
	

}

option log_file '';
