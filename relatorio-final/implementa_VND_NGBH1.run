#VND - neighborhood 1

restore neighborhood_VND1_FCB01;
restore neighborhood_VND1_FCB02;
restore neighborhood_VND1_SCB01;
restore neighborhood_VND1_SCB02;
restore neighborhood_VND1_SCB03;
restore neighborhood_VND1_SCB04;
restore neighborhood_VND1_BB01;
restore neighborhood_VND1_BB02;
#restore neighborhood_VND1_PV01;
#restore neighborhood_VND1_PV02;
restore neighborhood_VND1_GD01;
restore neighborhood_VND1_GD02;
	
#for {i in CB}{
