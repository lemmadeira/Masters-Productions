printf"\n\n||  =========  ||  =========  ||  =========  ||  =========  ||  =========  ||  =========    \n\n";

let penalty := c_pen*Sbase*365*Dt* sum{y in Y,(i,j) in B,(t,ss) in SC}(Prob[t,ss]*I2[y,i,j,t,ss]);
let FO1w := (w)*(1/(15))*( sum{i in PV}Pper[i]);
let FO2w := -(1-w)*(1/2250000)*( Sbase*365*Dt * sum{y in Y} (( 1 / ((1 + TD)^(y-1))) * (sum{(t,ss) in SC} Prob[t,ss]*( 
															sum{(i,j) in B}(R[i,j]*I2[y,i,j,t,ss]*1e-3 * CostE_buy[t,ss])
															+ (PS[y,1,t,ss]* 1e-3 *CostE_buy[t,ss])
															- (PSn[y,1,t,ss]* 1e-3 *CostE_buy[t,ss]*0.6)
															+ (CostFuel + CostGD_OeM)*sum{i in GD}(Pgd[i,t]*1e-3)
															+ sum{i in PV}(Phc[i,t,ss]* 1e-3 *CostE_PV) 
															)))
															+ sum{i in CB}(Cfcb*Nfcb[i]) + sum{i in CB}(Cscb*Nscb_max[i]) + sum{i in BB}(Cbb*Nsae[i]) + sum{i in GD}(Cgd*Ngd[i]) );
let HC := Sbase*sum{i in PV}Pper[i]*1e-3;
let CostSS := Sbase*365*Dt * sum{y in Y} (( 1 / ((1 + TD)^(y-1))) * (sum{(t,ss) in SC} Prob[t,ss]*(CostE_buy[t,ss]*PS[y,1,t,ss]*1e-3)));
let EnerSold := Sbase*365*Dt * sum{y in Y} (( 1 / ((1 + TD)^(y-1))) * (sum{(t,ss) in SC} Prob[t,ss]*((PSn[y,1,t,ss]* 1e-3 *CostE_buy[t,ss]*0.6))));
let CostDSOtoPV := Sbase*365*Dt * sum{y in Y} (( 1 / ((1 + TD)^(y-1))) * (sum{(t,ss) in SC} Prob[t,ss]*(sum{i in PV}(Phc[i,t,ss]*1e-3 * CostE_PV))));
let CostLoss := Sbase*365*Dt * sum{y in Y} (( 1 / ((1 + TD)^(y-1))) * (sum{(t,ss) in SC} Prob[t,ss]*(sum{(i,j) in B}(R[i,j]*I2[y,i,j,t,ss]*1e-3 * CostE_buy[t,ss]))));
let CostInvFCB := sum{i in CB}(Cfcb*Nfcb[i]);
let CostInvSCB := sum{i in CB}(Cscb*Nscb_max[i]);
let CostInvESS := sum{i in BB}(Cbb*Nsae[i]);
let CostInvGD := sum{i in GD}(Cgd*Ngd[i]);
let CostEneGD := Sbase*365*Dt * sum{y in Y} (( 1 / ((1 + TD)^(y-1))) * (sum{(t,ss) in SC} Prob[t,ss]*(CostFuel*sum{i in GD}(Pgd[i,t]*1e-3))));
let CostOeMGD := Sbase*365*Dt * sum{y in Y} (( 1 / ((1 + TD)^(y-1))) * (sum{(t,ss) in SC} Prob[t,ss]*(CostGD_OeM*sum{i in GD}(Pgd[i,t]*1e-3))));;
let CostTotal := CostLoss + CostSS - EnerSold + CostDSOtoPV + CostEneGD + CostOeMGD + CostInvFCB + CostInvSCB + CostInvESS + CostInvGD;
let EnergyGD := Sbase*365*Dt * sum{y in Y} (( 1 / ((1 + TD)^(y-1))) * (sum{(t,ss) in SC} Prob[t,ss]*(sum{i in GD}(Pgd[i,t]*1e-3))));
let EnergySS := Sbase*365*Dt * sum{y in Y} (( 1 / ((1 + TD)^(y-1))) * (sum{(t,ss) in SC} Prob[t,ss]*(PS[y,1,t,ss]*1e-3)));
let EnergyPV := Sbase*365*Dt * sum{y in Y} (( 1 / ((1 + TD)^(y-1))) * (sum{(t,ss) in SC} Prob[t,ss]*(sum{i in PV}(Pper[i]*fatGer[t,ss]*1e-3))));
let EnergyPVcurt := Sbase*365*Dt * sum{y in Y} (( 1 / ((1 + TD)^(y-1))) * (sum{(t,ss) in SC} Prob[t,ss]*(sum{i in PV}(Pcurt[i,t,ss]*1e-3))));

display bestTime;
printf'\nPenalization =\t%.5f\n\n',penalty;
printf'\nFO1 =\t%.5f\n\n',FO1w;
printf'\nFO2 =\t%.5f\n\n',FO2w;
