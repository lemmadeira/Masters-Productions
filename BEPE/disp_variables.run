display CostSS;
display EnerSold;
display CostDSOtoPV;
display CostLoss;
display CostEneGD;
display CostOeMGD;
display CostInvFCB;
display CostInvSCB;
display CostInvESS;
display CostInvGD;
display CostTotal;
display EnergyGD;
display EnergySS;
display EnergyPV;
