printf"\n\n";
for {y in Y}{
	for{(i,j) in B}{
		for{(t,ss) in SC}{
			if (((V2[y,j,t,ss]*I2[y,i,j,t,ss]) - (P[y,i,j,t,ss]^2 + Q[y,i,j,t,ss]^2))/V2[y,j,t,ss]*I2[y,i,j,t,ss]) > 0.005 then {
				printf"%.8f\t",(1 - (V2[y,j,t,ss]*I2[y,i,j,t,ss])/(P[y,i,j,t,ss]^2 + Q[y,i,j,t,ss]^2))*100;
				let infeasibility[contRepeat,cont_w] := 1;
			}
		}
	}
}

printf"\n\n Curtailment\n\n";
for {i in PV}{
	printf"\n\n";
	for {ss in Scen}{
		printf"\n";
		for {t in PER}{
			printf"%.4f\t",Pcurt[i,t,ss]*Sbase;
		}
	}
	printf"\n";
	for {ss in Scen}{
		printf"\n";
		for {t in PER}{
			printf"%.4f\t",Pper[i]*fatGer[t,ss]*Sbase;
		}
	}
}
printf"\n\n ";
for {i in PV}{
	let PcurtSum[i] := sum{(t,ss) in SC}(Prob[t,ss]*Pcurt[i,t,ss]);
	let PmaxSum[i] := sum{(t,ss) in SC}(Prob[t,ss]*Pper[i]*fatGer[t,ss]);
}
let PcurtSumSum := sum{i in PV}(PcurtSum[i]);
let PmaxSumSum := sum{i in PV}(PmaxSum[i]);
printf"\nPcurtSum\n\n";
for {i in PV}{
	printf"%.4f\t",PcurtSum[i]*Sbase;
}
printf"\n\nPmaxSum\n\n";
for {i in PV}{
	printf"%.4f\t",PmaxSum[i]*Sbase;
}
printf"\nPcurtSumSum\n\n";
printf"%.4f\t",PcurtSumSum*Sbase;
printf"\n\nPmaxSumSum\n\n";
printf"%.4f\t",PmaxSumSum*Sbase;



