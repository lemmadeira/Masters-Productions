# =========  ||  =========  ||  =========  ||  =========  ||  =========

# Veículos Elétricos

for {i in 0..23}{
	let dEV[i] := dEVaux[i]/Sbase;
	let qEV[i] := dEV[i]*tan(acos(0.98));
}

# =========  ||  =========  ||  =========  ||  =========  ||  =========

# Conversão dos Dados Para PU


for {i in N} {
	let SMAX[i] := SMAX[i]/Sbase;
	let PD[i] := PD[i]/Sbase;		#Per unit 
	let QD[i] := QD[i]/Sbase;		#Per unit
	let SD[i]   := sqrt(PD[i]^2 + QD[i]^2);		#Per unit
}
let {i in N} FPD[i]  := 1;		#Per unit
let {i in N :SD[i]<>0} FPD[i]  := PD[i]/SD[i];		#Per unit

for {(i,j) in B} {
	let R[i,j]  := R[i,j]/(1000*Vbase^2/Sbase);		#Per unit
	let X[i,j]  := X[i,j]/(1000*Vbase^2/Sbase);		#Per unit
	let Z2[i,j] := R[i,j]^2 + X[i,j]^2;

	let Imax[i,j] := (Imax[i,j]/(Sbase/(Vbase*sqrt(3))));		#Per unit 
	
	let Gl[i,j] := (R[i,j]/(R[i,j]^2+X[i,j]^2));
	let Bl[i,j] := (X[i,j]/(R[i,j]^2+X[i,j]^2));
}

# =========  ||  =========  ||  =========  ||  =========  ||  =========

# Fixando Variáveis Operacionais

fix {y in Y, i in N,(t,ss) in SC: Tb[i] == 1} V2[y,i,t,ss] := (Vnom/Vbase)^2; # Fixando tensão da subestação

fix {y in Y, i in N, (t,ss) in SC: Tb[i] <> 1} PS[y,i,t,ss] := 0;
fix {y in Y, i in N, (t,ss) in SC: Tb[i] <> 1} QS[y,i,t,ss] := 0;

fix {y in Y, i in N, (t,ss) in SC} PSn[y,i,t,ss] := 0;
unfix {y in Y, i in N, (t,ss) in SC: Tb[i] == 1} PSn[y,i,t,ss];
