let PNpv_ds := 100/Sbase;     # kW
let PNpv_in := 100/Sbase;     # kW
let Spv_ds := 110/Sbase;		# kVA
let deltaPV := -0.0045;
let NOCT := 45;
let Ppv_mod := 400/Sbase;

let Spv_in := 1.1*Ppv_mod;
let Qpv_max := 0.44*Spv_in;
let Qpv_min := -0.44*Spv_in;
let V1pv := 0.92;
let V2pv := 0.98;
let V3pv := 1.02;
let V4pv := 1.08;
let FRV := 5;
let omega1 := (0 - Qpv_max)/(V2pv - V1pv);
let omega2 := (Qpv_min - 0)/(V4pv - V3pv);

for {(t,ss) in SC}{
	let Tcel[t,ss] := Tamb+(NOCT-20)*G[t,ss]/800; 
	let fatGer[t,ss] := (G[t,ss]/1000) * ( 1 + deltaPV*(Tcel[t,ss] - 25) );
