}

let CostPV_OeM := 5;   # $/MWh       Shih-Chieh Hsieh 2011



# =========  ||  =========  ||  =========  ||  =========  ||  =========

# Geradores Distribuídos

let NMGD := 4;
let SgdMAX := 100/Sbase;     # kVA
let FPgd := 0.8;
let CostFuel := 29;   # $/MWh        # Amir Ameli 2014
let CostGD_OeM := 7; # $/MWh         # Amir Ameli 2014

# =========  ||  =========  ||  =========  ||  =========  ||  =========

# Emissões

let CostEmi := 10;    # $/ton
let fatEmi := 2.17;   # kgCO2/kWh 
let fatEmiGD := 0.63; # kgCO2/kWh

# =========  ||  =========  ||  =========  ||  =========  ||  =========

# Fator de Demanda

let FatDem[1] := 1;
for {y in Y:y>1}{
	let FatDem[y] := (1 + TCD)*FatDem[y-1];
}

